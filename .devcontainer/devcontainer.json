{
  "name": "Secure Agent Lab Architecture Viewer",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "forwardPorts": [
    8765
  ],
  "portsAttributes": {
    "8765": {
      "label": "Private Architecture Viewer",
      "onAutoForward": "openBrowser"
    }
  },
  "postStartCommand": "nohup python3 -m http.server 8765 --bind 0.0.0.0 --directory architecture > /tmp/architecture-viewer.log 2>&1 < /dev/null &",
  "customizations": {
    "vscode": {
      "extensions": []
    }
  }
}
